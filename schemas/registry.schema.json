{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otion.dev/schemas/registry.schema.json",
  "title": "Otion Extension Registry",
  "description": "Schema for registry.json — the list of extensions approved for the Otion Marketplace.",
  "type": "object",
  "required": ["version", "extensions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version of the registry file format."
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "ISO date the registry was last edited."
    },
    "extensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/extension" },
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "items": { "$ref": "#/$defs/extension" },
      "description": "Documentation-only entries. Clients ignore this array; it exists so readers can see the shape of a complete entry without scanning the schema."
    }
  },
  "$defs": {
    "extension": {
      "type": "object",
      "required": [
        "name",
        "description",
        "repository",
        "categories",
        "license",
        "latest_version",
        "min_host_version",
        "versions"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Globally unique name. Must match the name field in the extension's otion.json."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "categories": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "license": {
          "type": "string",
          "description": "SPDX identifier."
        },
        "latest_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Must match the version field of the most recent entry in versions[]."
        },
        "min_host_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/version" }
        }
      }
    },
    "version": {
      "type": "object",
      "required": ["version", "tag", "commit_sha", "approved_at", "reviewer"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full 40-character SHA the tag pointed to at review time. Tags are mutable; SHAs are not."
        },
        "approved_at": {
          "type": "string",
          "format": "date"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "description": "GitHub handle of the merging reviewer."
        }
      }
    }
  }
}
