{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otion.dev/schemas/otion.schema.json",
  "title": "Otion Extension Manifest",
  "description": "Schema for otion.json, the manifest at the root of every Otion extension repository. Mirrors RULES.md \u00a72.",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "author",
    "license",
    "repository",
    "entry",
    "build",
    "permissions",
    "dependencies",
    "min_host_version"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Globally unique within the marketplace. Lowercase, hyphen-separated."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Strict semver: MAJOR.MINOR.PATCH."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "One-line summary, plain text."
    },
    "author": {
      "type": "object",
      "required": [
        "name",
        "contact"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string",
          "minLength": 1,
          "description": "Email or URL where the author can be reached."
        }
      }
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier matching the LICENSE file."
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/",
      "description": "Full GitHub URL."
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to the entry point (after build, if any)."
    },
    "build": {
      "type": "null",
      "description": "The host never executes install-time builds. Prepare reviewed JavaScript source before publishing."
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "document:read",
          "document:write",
          "storage",
          "clipboard:write"
        ]
      },
      "description": "Every capability the extension uses, narrowest scope possible (RULES.md \u00a75)."
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      },
      "description": "Runtime dependencies. Versions must be exact \u2014 no ranges (RULES.md \u00a74.2)."
    },
    "min_host_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Minimum version of Otion required."
    },
    "extra": {
      "type": "object",
      "description": "Namespaced container for non-standard fields. Unknown top-level keys cause rejection (RULES.md \u00a72)."
    },
    "blocks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "type",
          "title",
          "description",
          "fields"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_]*$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "maxProperties": 20,
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "guides": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9-]+\\.md$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "sha256"
      ],
      "properties": {
        "api_version": {
          "const": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "widgets": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
